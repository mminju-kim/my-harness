{
  "version": 1,
  "sources": ["harness/r5-gates.md", "docs/design.md", "docs/story-service.md"],
  "screens": ["home", "free-content", "member-library", "skill-library", "mission-detail", "submission", "my-learning", "my-assets", "asset-detail", "admin-review"],
  "frame": { "width": 390, "height": 844 },

  "M1": {
    "sections": ["목적", "유저스토리", "데이터 필드", "권한", "상태값"],
    "story_section": "유저스토리",
    "story_ref_pattern": "US-[1-5]"
  },
  "M2": {
    "min": 5,
    "max": 8,
    "fields": ["ui_url", "UX 포인트", "UI 포인트", "반영할 것"]
  },
  "M3": { "min": 2, "max": 3 },

  "D1": {
    "colors": ["#141414", "#262626", "#707070", "#adadad", "#ffffff", "#f3f3f3", "#f0f0f0", "#e0e0e0", "#0066ff"],
    "opacity": 1,
    "exceptions": {
      "badge-overlay": [{ "color": "#737373", "opacity": 0.56 }]
    }
  },
  "D2": {
    "accent": "#0066ff",
    "max_per_frame": 2,
    "forbidden_components": ["button-primary"]
  },
  "D3": {
    "radii": [0, 16, 24, 9999],
    "squircle_component": "app-icon-squircle",
    "squircle_ratio": 0.3,
    "squircle_tolerance": 0.5
  },
  "D4": {
    "shadow_types": ["DROP_SHADOW", "INNER_SHADOW"],
    "allowed_components": ["segmented-control-active"]
  },
  "D5": {
    "families": ["Pretendard", "Pretendard Variable"],
    "weights": [300, 400, 600, 700],
    "letter_spacing": 0,
    "heading_style_prefixes": ["display", "heading-"],
    "heading_weight": 700
  },
  "D6": {
    "spacing": [0, 4, 8, 12, 16, 24, 32, 48, 64],
    "keys": ["paddingTop", "paddingRight", "paddingBottom", "paddingLeft", "itemSpacing", "counterAxisSpacing"]
  },
  "D7": {
    "components": ["text-input"],
    "rest_states": [null, "rest"]
  },
  "D8": {},

  "A1": {
    "screens": ["my-assets", "asset-detail", "submission"],
    "component": "visibility-control",
    "default": "private"
  },
  "A2": {
    "screens": ["my-assets", "asset-detail", "submission"],
    "component": "visibility-option",
    "value": "sale_requested",
    "allowed_roles": ["seller"]
  },
  "B1": {
    "screens": ["admin-review", "asset-detail"],
    "component": "review-checklist",
    "items": {
      "C1": "실제 업무에 써본 것",
