      "C4": "초보자가 따라할 수 있는 것",
      "C5": "특정 툴/버전/환경 조건이 적혀 있는 것",
      "C6": "개인정보/고객정보/회사기밀이 없는 것",
      "C7": "저작권 문제가 없는 것",
      "C8": "구매자가 바로 써볼 수 있는 것"
    }
  },
  "B2": {
    "screens": ["admin-review"],
    "button": "approve-button",
    "checklist": "review-checklist"
  },
  "B3": {
